{
  "name": "machinemaker",
  "version": "1.0.0-alpha",
  "description": "MachineMaker \u2014 desktop editor for hand-authoring RTL block diagrams.",
  "author": "Joshua H. Kirby",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tst/tsconfig.json",
    "package": "electron-vite build && electron-builder",
    "test": "playwright test --config tst/playwright.config.ts",
    "package:dir": "electron-vite build && electron-builder --dir --publish never"
  },
  "dependencies": {
    "@xyflow/react": "^12.3.5",
    "nanoid": "^5.0.7",
    "yaml": "^2.6.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "html-to-image": "^1.11.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^8.3.5"
  }
}
